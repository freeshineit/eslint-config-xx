{
  "name": "with-lit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "fmt": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx,css,md,json}\"",
    "fmt:check": "prettier --check \"src/**/*.{js,mjs,jsx,ts,tsx,css,md,json}\""
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-xx": "workspace:*",
    "prettier": "^3.9.6",
    "vite": "^8.3.0"
  }
}

{
  "name": "eslint-config",
  "version": "0.0.0",
  "description": "eslint config xx",
  "scripts": {
    "build": "pnpm run --filter '*' build",
    "lint": "pnpm run --filter '*' lint",
    "lint:fix": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx,.vue --fix",
    "fmt": "pnpm run --filter '*' fmt",
    "fmt:check": "prettier --check \"**/*.{js,mjs,jsx,ts,tsx,vue,css,md,json}\"",
    "lint:fmt": "npm run lint && npm run fmt:check",
    "prepare": "husky"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "prettier",
    "prettier config"
  ],
  "author": "ShineShao <xiaoshaoqq@gmail.com>",
  "license": "MIT",
  "files": [
    "index.js",
    "prettier.config.js",
    "tsconfig.json"
  ],
  "dependencies": {
    "eslint": "^10.10.0",
    "eslint-config-xx": "workspace:*",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "repository": "git@github.com:freeshineit/eslint-config-xx.git",
  "bugs": {
    "url": "https://github.com/freeshineit/eslint-config-xx/issues"
  },
  "homepage": "https://github.com/freeshineit/eslint-config-xx",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "only-allow": "^1.2.2",
    "pretty-quick": "^4.2.2"
  }
}

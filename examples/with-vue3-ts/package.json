{
  "name": "with-vue3-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "fmt": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx,css,md,json,vue}\"",
    "fmt:check": "prettier --check \"src/**/*.{js,mjs,jsx,ts,tsx,css,md,json,vue}\""
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint-config-xx": "workspace:*",
    "npm-run-all2": "^9.0.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}

{
  "name": "eslint-config-xx",
  "version": "3.0.0",
  "description": "eslint config xx",
  "main": "eslint.config.mjs",
  "module": "eslint.config.mjs",
  "keywords": [
    "eslint",
    "eslint-config",
    "prettier",
    "prettier config"
  ],
  "author": "ShineShao <xiaoshaoqq@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "",
    "lint": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx,.vue",
    "lint:fix": "eslint . --ext .js,.mjs,.jsx,.ts,.tsx,.vue --fix",
    "fmt": "prettier --write \"**/*.{js,mjs,jsx,ts,tsx,vue,css,md,json}\"",
    "fmt:check": "prettier --check \"**/*.{js,mjs,jsx,ts,tsx,vue,css,md,json}\"",
    "lint:fmt": "npm run lint && npm run fmt:check"
  },
  "files": [
    "eslint.config.mjs",
    "prettier.config.mjs",
    "tsconfig.json"
  ],
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-love": "^157.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "repository": "git@github.com:freeshineit/eslint-config-xx.git",
  "bugs": {
    "url": "https://github.com/freeshineit/eslint-config-xx/issues"
  },
  "homepage": "https://github.com/freeshineit/eslint-config-xx/tree/main/configs",
  "engines": {
    "node": ">=22"
  }
}
